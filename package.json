{
  "name": "obsidian-latex-studio",
  "version": "0.2.2",
  "description": "A complete LaTeX project editor and PDF preview for Obsidian.",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
